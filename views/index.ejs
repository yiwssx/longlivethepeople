<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('./partials/metadata'); %>
</head>

<body class="memorial-page">
    <main class="page-shell">
        <section class="hero-card">
            <div class="hero-media">
                <img class="hero-image" src="/assets/img/longlivethepeople.jpg" alt="Long Live the People" fetchpriority="high" />
            </div>
        </section>

        <section class="compose-card">
            <form id="message-form" class="message-form" autocomplete="off" novalidate>
                <div class="field-group">
                    <textarea
                        class="form-control message-input"
                        id="message"
                        name="message"
                        rows="6"
                        maxlength="2000"
                        placeholder="ข้อความแสดงความไว้อาลัย"
                        aria-label="ข้อความแสดงความไว้อาลัย"
                        required></textarea>
                </div>

                <div class="form-grid">
                    <div class="field-group">
                        <input
                            class="form-control"
                            type="text"
                            id="codename"
                            name="codename"
                            maxlength="80"
                            placeholder="นามแฝง"
                            aria-label="นามแฝง"
                            required />
                    </div>

                    <div class="field-group">
                        <input
                            class="form-control"
                            type="text"
                            id="affiliation"
                            name="affiliation"
                            maxlength="120"
                            placeholder="สังกัด"
                            aria-label="สังกัด"
                            required />
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" id="send" type="submit">ไว้อาลัย</button>
                </div>
            </form>
        </section>

        <section class="feed-section">
            <div class="section-heading feed-heading">
                <div>
                    <p class="eyebrow">ผู้ไว้อาลัย::สังกัด</p>
                    <h2>ข้อความไว้อาลัย</h2>
                </div>
            </div>

            <div id="messages" class="message-feed" aria-live="polite"></div>
        </section>
    </main>

    <footer class="site-footer">
        <span>Fuck</span>
        <span>Military Government</span>
    </footer>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/assets/js/script.js"></script>
</body>

</html>
