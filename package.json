{
  "name": "longlivethepeople",
  "version": "1.0.0",
  "private": true,
  "description": "Archived Long Live the People memorial web application",
  "author": "noirisaesthetic",
  "license": "UNLICENSED",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.7.2",
    "serve-favicon": "^2.5.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "public",
      "views"
    ],
    "ignore": [
      "**/__tests__/**",
      "*.test.js",
      "*.spec.js"
    ]
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "cross-env NODE_ENV=development node ./src/server.js",
    "watch:dev": "cross-env NODE_ENV=development nodemon ./src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "test:all": "npm run test && npm run test:e2e"
  }
}
