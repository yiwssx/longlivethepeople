{
  "name": "longlivethepeople",
  "version": "1.0.0",
  "private": true,
  "description": "Archived Long Live the People memorial web application",
  "author": "noirisaesthetic",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serve-favicon": "^2.5.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ignore": [
      "**/__tests__/**",
      "*.test.js",
      "*.spec.js"
    ]
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env NODE_ENV=development node ./src/server.js",
    "dev:client": "vite",
    "watch:dev": "npm run dev",
    "build": "vite build",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:e2e": "npm run build && cross-env NODE_ENV=test playwright test",
    "test:e2e:ci": "cross-env NODE_ENV=test playwright test",
    "test:all": "npm run typecheck && npm run build && npm run test && npm run test:e2e:ci"
  }
}
